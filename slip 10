Q1) Armstrong Number using Toast
int n=153,temp=n,sum=0,r;

while(n>0){
    r=n%10;
    sum=sum+(r*r*r);
    n=n/10;
}

if(temp==sum)
    Toast.makeText(this,"Armstrong Number",Toast.LENGTH_SHORT).show();
else
    Toast.makeText(this,"Not Armstrong",Toast.LENGTH_SHORT).show();
